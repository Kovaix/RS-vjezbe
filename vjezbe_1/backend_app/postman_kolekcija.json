{
  "info": {
    "name": "RS Vježba 1 - Restoran API",
    "description": "Uvezi u Postman (Import → File). Prije slanja promijeni varijablu kolekcije base_url u URL svog backenda na Renderu.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "https://rs-vjezbe-backend.onrender.com" }
  ],
  "item": [
    { "name": "GET /", "request": { "method": "GET", "url": "{{base_url}}/" } },
    { "name": "GET /health", "request": { "method": "GET", "url": "{{base_url}}/health" } },
    { "name": "GET /jelovnik", "request": { "method": "GET", "url": "{{base_url}}/jelovnik" } },
    {
      "name": "GET /jelovnik?kategorija=desert",
      "request": {
        "method": "GET",
        "url": { "raw": "{{base_url}}/jelovnik?kategorija=desert", "host": ["{{base_url}}"], "path": ["jelovnik"], "query": [{ "key": "kategorija", "value": "desert" }] }
      }
    },
    { "name": "GET /jelovnik/3", "request": { "method": "GET", "url": "{{base_url}}/jelovnik/3" } },
    {
      "name": "POST /narudzbe",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"jelo_id\": 4,\n  \"kolicina\": 3,\n  \"napomena\": \"za van\"\n}" },
        "url": "{{base_url}}/narudzbe"
      }
    },
    { "name": "GET /narudzbe", "request": { "method": "GET", "url": "{{base_url}}/narudzbe" } },
    { "name": "DELETE /narudzbe/1", "request": { "method": "DELETE", "url": "{{base_url}}/narudzbe/1" } }
  ]
}
